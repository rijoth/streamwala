<?xml version="1.0" encoding="utf-8"?>
<!--
  TV flavor overlay: adds the leanback launcher entry point so the app appears
  in the Android TV / Google TV home screen row (and Fire TV app list).
  The mobile flavor never sees this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.StreamwalaTv"
            tools:replace="android:theme"
            tools:node="merge">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>
    </application>

</manifest>
