# =============================================================================
# Streamwala — .gitignore
#
# Sections
#   1. Dependencies
#   2. Build, tooling and native-shell output
#   3. Tests, coverage and reports
#   4. Logs
#   5. Editor, IDE and OS noise
#   6. Secrets and credentials   (env files, keys, cloud/service config)
#   7. IPTV data                 (playlists, EPG, exports — Xtream URLs carry
#                                 usernames and passwords, so these are secrets)
#   8. Local-only agent / scratch files
#   9. Deliberately committed    (negations — do not remove without review)
#
# Notes
#   * .gitignore has no inline comments and ignores *untracked* files only.
#     If something sensitive is already tracked, `git rm --cached <path>` it
#     (review first) — this file alone will not remove it from history.
#   * Anything a build produces belongs here; anything a human writes and the
#     repo needs belongs in section 9.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Dependencies
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Package-manager debug / error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# 2. Build, tooling and native-shell output
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
.cache/
*.tsbuildinfo
.eslintcache
.eslintcache.*

# Generated by the AI Studio / Express dev harness — see `npm run clean`
server.js

# Python bytecode (scripts/android-assets.py etc.)
__pycache__/
*.py[cod]

# PWA / service-worker build output (generated at build time).
# Hand-written PWA sources belong in `public/` and stay tracked (section 9).
sw.js
sw.js.map
workbox-*.js
workbox-*.js.map
precache-manifest*.js

# Capacitor / Android native shell: generated, machine-local or signed output
android/.gradle/
android/build/
android/app/build/
# Release-pipeline scratch directories (created by .github/workflows/release.yml)
release-artifacts/
staging/
android/app/release/
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/
android/app/src/main/res/xml/config.xml
android/local.properties
android/keystore.properties
android/*.jks
android/*.keystore
android/.idea/

# Native app packages and VM dumps
*.apk
*.aab
*.ap_
*.ipa
*.dex
*.hprof

# -----------------------------------------------------------------------------
# 3. Tests, coverage and reports
# -----------------------------------------------------------------------------
coverage/
coverage-final.json
lcov.info
*.lcov
.nyc_output/
playwright-report/
blob-report/
test-results/
.playwright/
.playwright-artifacts-*/
playwright/.cache/

# -----------------------------------------------------------------------------
# 4. Logs
# -----------------------------------------------------------------------------
*.log
logs/
*.pid

# -----------------------------------------------------------------------------
# 5. Editor, IDE and OS noise
# -----------------------------------------------------------------------------
# VS Code: ignore the directory, then re-allow only shared, machine-agnostic
# settings. Keep these free of absolute paths, tokens and personal preferences.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets
!.vscode/README.md

# Other editors / IDEs
.idea/
*.iml
.fleet/
.history/
*.swp
*.swo
*~

# Signing/UI caches
*.sublime-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# -----------------------------------------------------------------------------
# 6. Secrets and credentials
# -----------------------------------------------------------------------------
# Environment files: every variant is ignored; only the placeholder template is
# kept (section 9). This covers .env, .env.local, .env.production, .env.*.local.
.env
.env.*
!.env.example

# Local machine overrides and direnv
*.local
.direnv/

# Private keys and certificates
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.mobileprovision
*.provisionprofile
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud / service credentials and CLI state
*credentials*.json
service-account*.json
serviceAccount*.json
.npmrc
.netrc
.aws/
.gcloud/
.firebase/
.vercel/
.netlify/
.docker/config.json
.kube/
*.kubeconfig
terraform.tfstate
terraform.tfstate.*
*.tfvars

# -----------------------------------------------------------------------------
# 7. IPTV data — playlists, EPG and exports
#
# Xtream Codes / M3U URLs embed credentials in the URL itself
# (http://host/get.php?username=USER&password=PASS), and XMLTV/EPG exports can
# carry channel account metadata. Treat every playlist or EPG file dropped in
# the working tree as a credential.
# -----------------------------------------------------------------------------
*.m3u
*.m3u8
*.m3u9
*.xmltv
*.epg.xml
*.epg.xml*
playlists/
xtream/
local/
private/

# Settings / playlist / backup JSON exports from the app's storage layer
*backup*.json
*settings-backup*.json
*settings-export*.json
*playlist-export*.json

# -----------------------------------------------------------------------------
# 8. Local-only agent / scratch files
# -----------------------------------------------------------------------------
.claude/
.cursor/
.windsurf/
.continue/
.specstory/
.aider*
.agent/
.pi/local/
AGENTS.local.md
CLAUDE.local.md
.scratch/
scratch/
tmp/
.tmp/
*.bak
*.orig
*.rej

# -----------------------------------------------------------------------------
# 9. Deliberately committed — do not remove without review
# -----------------------------------------------------------------------------
# Placeholder-only environment template. Never put real values in it.
!.env.example

# Lockfiles are always committed. Never ignore a lockfile.
# package-lock.json is authoritative (ADR 009). bun.lock is still tracked today;
# ADR 009 wants it removed in a separate cleanup — until then this line keeps
# the repository state honest instead of silently hiding a tracked file.
!package-lock.json
!bun.lock

# Sanitized, credential-free test fixtures. `!` here deliberately overrides the
# playlist/EPG/export patterns above so sanitized *.m3u / *.m3u8 / *.xmltv
# fixtures can be committed. They must contain no real hosts, usernames or
# passwords — see docs/DECISIONS.md.
!src/test/fixtures/**

# Hand-written service-worker source, if one is ever added under public/
!public/sw.js

# Repository documentation and agent guidelines
!AGENTS.md
!README.md
!docs/**
